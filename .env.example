# LittleCare Healthcare Management System Environment Variables
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=littlecare-secret-key-super-secure-dev-2026

# MySQL Database Configuration (XAMPP / MySQL Workbench default)
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=littlecare_db

# Optional direct Database URL override (e.g., mysql+pymysql://root:password@localhost/littlecare_db)
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/littlecare_db

# OpenAI API Configuration (Set your OpenAI key here for live AI assistant responses)
# Leave blank to use LittleCare's built-in intelligent pediatric fallback responses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
